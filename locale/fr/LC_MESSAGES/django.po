#: cuentas/forms.py
msgid "Nombre"
msgstr "Prénom"

#: cuentas/forms.py
msgid "Correo electrónico"
msgstr "E-mail"

#: cuentas/forms.py
msgid "Ya hay una cuenta con este correo."
msgstr "Un compte existe déjà avec cet e-mail."

#: cuentas/forms.py
msgid "Tu cuenta aún no está activada. Cuando la activen podrás entrar."
msgstr "Votre compte n'est pas encore activé. Vous pourrez vous connecter dès qu'il le sera."

#: cuentas/models.py escalas/templates/escalas/song.html
msgid "Partitura"
msgstr "Partition"

#: cuentas/models.py escalas/templates/escalas/song.html
msgid "Lluvia de notas"
msgstr "Pluie de notes"

#: cuentas/models.py
msgid "vista de las canciones"
msgstr "affichage des chansons"

#: cuentas/models.py
msgid "Partitura: las notas en el pentagrama. Lluvia de notas: las notas caen hacia su tecla."
msgstr "Partition : les notes sur la portée. Pluie de notes : les notes tombent vers leur touche."

#: cuentas/templates/cuentas/preferences.html
msgid "Preferencias · Piano"
msgstr "Préférences · Piano"

#: cuentas/templates/cuentas/preferences.html
msgid "Preferencias"
msgstr "Préférences"

#: cuentas/templates/cuentas/preferences.html
msgid "Las notas en el pentagrama, como en una partitura."
msgstr "Les notes sur la portée, comme sur une partition."

#: cuentas/templates/cuentas/preferences.html
msgid "Las notas caen hacia su tecla del teclado, con un color para cada mano."
msgstr "Les notes tombent vers leur touche du clavier, avec une couleur pour chaque main."

#: cuentas/templates/cuentas/preferences.html
msgid "Guardar"
msgstr "Enregistrer"

#: cuentas/templates/cuentas/register.html
msgid "Registro · Piano"
msgstr "Inscription · Piano"

#: cuentas/templates/cuentas/register.html
#, python-format
msgid "¡Cuenta creada, %(name)s!"
msgstr "Compte créé, %(name)s !"

#: cuentas/templates/cuentas/register.html
#, python-format
msgid "Tu cuenta <b>%(user)s</b> está pendiente de activación. Para activarla, envía un correo a:"
msgstr "Votre compte <b>%(user)s</b> est en attente d'activation. Pour l'activer, envoyez un e-mail à :"

#: cuentas/templates/cuentas/register.html
msgid "con tu nombre de usuario. Puedes usar este botón, que deja el mensaje escrito:"
msgstr "avec votre nom d'utilisateur. Vous pouvez utiliser ce bouton, qui prépare le message :"

#: cuentas/templates/cuentas/register.html
msgid "Escribir el correo"
msgstr "Écrire l'e-mail"

#: cuentas/templates/cuentas/register.html
#, python-format
msgid "Cuando tu cuenta esté activa podrás <a href=\"%(login_url)s\">entrar</a>."
msgstr "Quand votre compte sera actif, vous pourrez vous <a href=\"%(login_url)s\">connecter</a>."

#: cuentas/templates/cuentas/register.html
msgid "Crear cuenta"
msgstr "Créer un compte"

#: cuentas/templates/cuentas/register.html
#, python-format
msgid "Después de registrarte, envía un correo a <b>%(admin_email)s</b> para que activen tu cuenta."
msgstr "Après votre inscription, envoyez un e-mail à <b>%(admin_email)s</b> pour faire activer votre compte."

#: cuentas/templates/cuentas/register.html
msgid "Registrarme"
msgstr "M'inscrire"

#: cuentas/templates/cuentas/register.html
msgid "¿Ya tienes cuenta?"
msgstr "Vous avez déjà un compte ?"

#: cuentas/templates/cuentas/register.html
#: cuentas/templates/registration/login.html
#: escalas/templates/escalas/_nav.html
msgid "Entrar"
msgstr "Se connecter"

#: cuentas/templates/registration/login.html
msgid "Entrar · Piano"
msgstr "Connexion · Piano"

#: cuentas/templates/registration/login.html
msgid "Tu avance se guarda en tu cuenta: escalas, módulos y canciones."
msgstr "Votre progression est enregistrée dans votre compte : gammes, modules et chansons."

#: cuentas/templates/registration/login.html
msgid "¿No tienes cuenta?"
msgstr "Pas encore de compte ?"

#: cuentas/templates/registration/login.html
msgid "Regístrate"
msgstr "Inscrivez-vous"

#: cuentas/views.py
#, python-format
msgid "Activar cuenta: %(user)s"
msgstr "Activer le compte : %(user)s"

#: cuentas/views.py
#, python-format
msgid ""
"Hola, me registré en la app de piano y quisiera activar mi cuenta.\n"
"\n"
"Usuario: %(user)s\n"
"Nombre: %(name)s\n"
"Correo: %(email)s\n"
msgstr ""
"Bonjour, je me suis inscrit(e) sur l'application de piano et j'aimerais activer mon compte.\n"
"\n"
"Nom d'utilisateur : %(user)s\n"
"Nom : %(name)s\n"
"E-mail : %(email)s\n"

#: cuentas/views.py
msgid "Preferencias guardadas."
msgstr "Préférences enregistrées."

#: escalas/catalog_strings.py
msgid "Acompaña canciones con acordes."
msgstr "Accompagnez des chansons avec des accords."

#: escalas/catalog_strings.py
msgid "Acordes con sostenidos y bemoles"
msgstr "Accords avec dièses et bémols"

#: escalas/catalog_strings.py
msgid "Acordes de séptima"
msgstr "Accords de septième"

#: escalas/catalog_strings.py
msgid "Acordes de tensión y color para dar variedad a un acompañamiento."
msgstr "Des accords de tension et de couleur pour varier un accompagnement."

#: escalas/catalog_strings.py
msgid "Acordes mayores"
msgstr "Accords majeurs"

#: escalas/catalog_strings.py
msgid "Acordes menores"
msgstr "Accords mineurs"

#: escalas/catalog_strings.py
msgid "Aprende a leer el pentagrama nota a nota, hasta tocar piezas escritas."
msgstr "Apprenez à lire la portée note par note, jusqu'à jouer des pièces écrites."

#: escalas/catalog_strings.py
msgid "Aprende acordes, inversiones y progresiones para tocar con otros músicos."
msgstr "Apprenez les accords, les renversements et les progressions pour jouer avec d'autres musiciens."

#: escalas/catalog_strings.py
msgid "Arpegios de dos octavas en corcheas y bajo en negras, con el final en acordes."
msgstr "Arpèges sur deux octaves en croches et basse en noires, avec une fin en accords."

#: escalas/catalog_strings.py
msgid "Banda"
msgstr "Groupe"

#: escalas/catalog_strings.py
msgid "Blues de 12 compases"
msgstr "Blues en 12 mesures"

#: escalas/catalog_strings.py
msgid "Cada nota aparece en su clave, sol o fa, como en una partitura de piano. Cambia de lectura sin pausa."
msgstr "Chaque note apparaît dans sa clé, sol ou fa, comme sur une partition de piano. Changez de lecture sans pause."

#: escalas/catalog_strings.py
msgid "Canción de 1968 con derechos de autor vigentes: importa tu partitura en MIDI y la app crea las tres versiones."
msgstr "Chanson de 1968 toujours protégée par le droit d'auteur : importez votre partition MIDI et l'application crée les trois versions."

#: escalas/catalog_strings.py
msgid "Clave de fa: las notas del pentagrama"
msgstr "Clé de fa : les notes de la portée"

#: escalas/catalog_strings.py
msgid "Clave de fa: líneas adicionales"
msgstr "Clé de fa : lignes supplémentaires"

#: escalas/catalog_strings.py
msgid "Clave de sol: las notas del pentagrama"
msgstr "Clé de sol : les notes de la portée"

#: escalas/catalog_strings.py
msgid "Clave de sol: líneas adicionales"
msgstr "Clé de sol : lignes supplémentaires"

#: escalas/catalog_strings.py
msgid "Con segunda voz y bajo arpegiado"
msgstr "Avec seconde voix et basse arpégée"

#: escalas/catalog_strings.py
msgid "Del Do2 grave hasta el Mi4, que se escribe sobre el pentagrama de fa."
msgstr "Du do2 grave jusqu'au mi4, qui s'écrit au-dessus de la portée de fa."

#: escalas/catalog_strings.py
msgid "Disminuidos, aumentados y suspendidos"
msgstr "Diminués, augmentés et suspendus"

#: escalas/catalog_strings.py
msgid "Do, Fa, Sol, Re, La y Mi: los acordes más usados en canciones. Verás sus notas en el teclado."
msgstr "Do, fa, sol, ré, la et mi : les accords les plus utilisés dans les chansons. Vous verrez leurs notes sur le clavier."

#: escalas/catalog_strings.py
msgid "Doxología"
msgstr "Doxologie"

#: escalas/catalog_strings.py
msgid "Dórica"
msgstr "Dorienne"

#: escalas/catalog_strings.py
msgid "El famoso bajo en ciclo de quintas de la Suite en sol menor HWV 432. Aprende primero la mano derecha, luego la izquierda y al final las dos juntas."
msgstr "La célèbre basse en cycle de quintes de la Suite en sol mineur HWV 432. Apprenez d'abord la main droite, puis la gauche, et enfin les deux ensemble."

#: escalas/catalog_strings.py
msgid "El himno más cantado del mundo (Amazing Grace), en compás de tres."
msgstr "L'hymne le plus chanté au monde (Amazing Grace), à trois temps."

#: escalas/catalog_strings.py
msgid "El sonido más oscuro: La menor, Re menor, Mi menor y compañía."
msgstr "Le son le plus sombre : la mineur, ré mineur, mi mineur et compagnie."

#: escalas/catalog_strings.py
msgid "El villancico de Navidad por excelencia, con su suave balanceo en tres."
msgstr "Le chant de Noël par excellence, avec son doux balancement à trois temps."

#: escalas/catalog_strings.py
msgid "Encadena los tres acordes principales de una tonalidad, en Do y en Sol."
msgstr "Enchaînez les trois accords principaux d'une tonalité, en do et en sol."

#: escalas/catalog_strings.py
msgid "Frases de ocho notas con saltos amplios y alteraciones en clave de sol."
msgstr "Phrases de huit notes avec de grands sauts et des altérations en clé de sol."

#: escalas/catalog_strings.py
msgid "Frases de ocho notas para la mano izquierda, con saltos y alteraciones."
msgstr "Phrases de huit notes pour la main gauche, avec sauts et altérations."

#: escalas/catalog_strings.py
msgid "Frases por grados conjuntos"
msgstr "Phrases par degrés conjoints"

#: escalas/catalog_strings.py
msgid "Frigia"
msgstr "Phrygienne"

#: escalas/catalog_strings.py
msgid "Generada automáticamente: la melodía y un bajo por medio compás."
msgstr "Générée automatiquement : la mélodie et une basse toutes les demi-mesures."

#: escalas/catalog_strings.py
msgid "Generada automáticamente: teclas blancas, notas largas y una nota a la vez por mano."
msgstr "Générée automatiquement : touches blanches, notes longues et une note à la fois par main."

#: escalas/catalog_strings.py
msgid "Himno de la alegría"
msgstr "Hymne à la joie"

#: escalas/catalog_strings.py
msgid "Interestelar"
msgstr "Interstellar"

#: escalas/catalog_strings.py
msgid "La cadencia básica del jazz, con acordes de séptima, en Do, Fa, Si♭ y Mi♭."
msgstr "La cadence de base du jazz, avec des accords de septième, en do, fa, si♭ et mi♭."

#: escalas/catalog_strings.py
msgid "La clave de la mano izquierda: de Sol2 a La3, en líneas y espacios."
msgstr "La clé de la main gauche : du sol2 au la3, sur les lignes et les interlignes."

#: escalas/catalog_strings.py
msgid "La forma completa del blues con acordes de séptima, en Do y en Sol."
msgstr "La forme complète du blues avec des accords de septième, en do et en sol."

#: escalas/catalog_strings.py
msgid "La melodía completa con la fundamental de cada acorde en la izquierda."
msgstr "La mélodie complète avec la fondamentale de chaque accord à la main gauche."

#: escalas/catalog_strings.py
msgid "La melodía de la Novena sinfonía, cantada en iglesias como «Jubilosos te adoramos»."
msgstr "La mélodie de la Neuvième Symphonie, chantée dans les églises sous le titre « Jubilosos te adoramos »."

#: escalas/catalog_strings.py
msgid "La progresión de cientos de canciones, en cuatro tonalidades."
msgstr "La progression de centaines de chansons, en quatre tonalités."

#: escalas/catalog_strings.py
msgid "La progresión pop: I–V–vi–IV"
msgstr "La progression pop : I–V–vi–IV"

#: escalas/catalog_strings.py
msgid "Las dos claves alternadas"
msgstr "Les deux clés en alternance"

#: escalas/catalog_strings.py
msgid "Las mismas notas de la clave de sol, ahora con ♯ y ♭. Fíjate en la alteración antes de tocar."
msgstr "Les mêmes notes de la clé de sol, maintenant avec ♯ et ♭. Regardez l'altération avant de jouer."

#: escalas/catalog_strings.py
msgid "Lee frases cortas de cinco notas que se mueven por notas vecinas, como en una melodía."
msgstr "Lisez de courtes phrases de cinq notes qui procèdent par notes voisines, comme dans une mélodie."

#: escalas/catalog_strings.py
msgid "Lee partituras y toca música clásica."
msgstr "Lisez des partitions et jouez de la musique classique."

#: escalas/catalog_strings.py
msgid "Lidia"
msgstr "Lydienne"

#: escalas/catalog_strings.py
msgid "Locria"
msgstr "Locrienne"

#: escalas/catalog_strings.py escalas/templates/escalas/index.html
msgid "Mayor"
msgstr "Majeur"

#: escalas/catalog_strings.py
msgid "Melodía en Do"
msgstr "Mélodie en do"

#: escalas/catalog_strings.py
msgid "Menor armónica"
msgstr "Mineur harmonique"

#: escalas/catalog_strings.py
msgid "Menor melódica"
msgstr "Mineur mélodique"

#: escalas/catalog_strings.py
msgid "Menor natural"
msgstr "Mineur naturel"

#: escalas/catalog_strings.py
msgid "Mixolidia"
msgstr "Mixolydienne"

#: escalas/catalog_strings.py
msgid "Noche de paz"
msgstr "Douce nuit"

#: escalas/catalog_strings.py
msgid "Pentatónica mayor"
msgstr "Pentatonique majeure"

#: escalas/catalog_strings.py
msgid "Pentatónica menor"
msgstr "Pentatonique mineure"

#: escalas/catalog_strings.py
msgid "Primera vista en clave de fa"
msgstr "Lecture à vue en clé de fa"

#: escalas/catalog_strings.py
msgid "Primera vista: saltos y alteraciones"
msgstr "Lecture à vue : sauts et altérations"

#: escalas/catalog_strings.py
msgid "Reconoce las nueve notas que caen en las líneas y espacios, de Mi4 a Fa5, y tócalas en el piano."
msgstr "Reconnaissez les neuf notes qui tombent sur les lignes et les interlignes, du mi4 au fa5, et jouez-les au piano."

#: escalas/catalog_strings.py
msgid "Segunda voz en los tiempos fuertes y bajo arpegiado en negras."
msgstr "Seconde voix sur les temps forts et basse arpégée en noires."

#: escalas/catalog_strings.py
msgid "Si♭, Mi♭, La♭, Fa♯ menor… Ahora las notas solo aparecen si te equivocas."
msgstr "Si♭, mi♭, la♭, fa♯ mineur… Maintenant les notes n'apparaissent que si vous vous trompez."

#: escalas/catalog_strings.py
msgid "Solista"
msgstr "Soliste"

#: escalas/catalog_strings.py
msgid "Solo teclas blancas: la melodía en notas largas y una nota de bajo por compás."
msgstr "Touches blanches uniquement : la mélodie en notes longues et une note de basse par mesure."

#: escalas/catalog_strings.py
msgid "Sostenidos y bemoles"
msgstr "Dièses et bémols"

#: escalas/catalog_strings.py
msgid "Sublime gracia"
msgstr "Amazing Grace"

#: escalas/catalog_strings.py
msgid "Suma el Do central y las notas que se salen del pentagrama por arriba, hasta La5."
msgstr "Ajoutez le do central et les notes qui dépassent de la portée vers le haut, jusqu'au la5."

#: escalas/catalog_strings.py
msgid "Séptima de dominante, menor séptima y séptima mayor: el color del pop, el soul y el jazz."
msgstr "Septième de dominante, septième mineure et septième majeure : la couleur de la pop, de la soul et du jazz."

#: escalas/catalog_strings.py
msgid "Tu primera progresión: I–IV–V"
msgstr "Votre première progression : I–IV–V"

#: escalas/catalog_strings.py
msgid "baja natural"
msgstr "descendante naturelle"

#: escalas/catalog_strings.py
msgid "ii–V–I en cuatro tonalidades"
msgstr "ii–V–I dans quatre tonalités"

#: escalas/catalog_strings.py
msgid "«A Dios el Padre celestial»: el antiguo salmo 100, en notas largas y solemnes."
msgstr "« Louez Dieu, le Père céleste » : l'ancien psaume 100, en notes longues et solennelles."

#: escalas/catalog_strings.py
msgid "Jean Renard y Pierre Delanoë (canta Sylvie Vartan)"
msgstr "Jean Renard et Pierre Delanoë (chantée par Sylvie Vartan)"

#: escalas/catalog_strings.py
msgid "Melodía tradicional «New Britain» (1829)"
msgstr "Mélodie traditionnelle « New Britain » (1829)"

#: escalas/catalog_strings.py
msgid "Primeros pasos"
msgstr "Premiers pas"

#: escalas/catalog_strings.py
msgid "Empieza aquí si nunca has tocado el piano."
msgstr "Commencez ici si vous n'avez jamais joué du piano."

#: escalas/catalog_strings.py
msgid "Conoce el teclado, encuentra las notas y toca tus primeras melodías. Después podrás seguir con Solista (leer partituras) o con Banda (acordes)."
msgstr "Découvrez le clavier, trouvez les notes et jouez vos premières mélodies. Ensuite, vous pourrez continuer avec Soliste (lire des partitions) ou Groupe (accords)."

#: escalas/catalog_strings.py
msgid "Encuentra el Do"
msgstr "Trouvez le do"

#: escalas/catalog_strings.py
msgid "El Do es la tecla blanca justo a la izquierda de cada grupo de dos teclas negras. Búscalo en todo el teclado."
msgstr "Le do est la touche blanche située juste à gauche de chaque groupe de deux touches noires. Cherchez-le sur tout le clavier."

#: escalas/catalog_strings.py
msgid "Las siete notas blancas"
msgstr "Les sept notes blanches"

#: escalas/catalog_strings.py
msgid "Do, Re, Mi, Fa, Sol, La y Si: aprende dónde está cada una a partir del Do central."
msgstr "Do, ré, mi, fa, sol, la et si : apprenez où se trouve chacune à partir du do central."

#: escalas/catalog_strings.py
msgid "Cinco notas, cinco dedos"
msgstr "Cinq notes, cinq doigts"

#: escalas/catalog_strings.py
msgid "Mano derecha sobre Do, Re, Mi, Fa y Sol con los dedos 1 al 5. Toca la nota que se indica con su dedo."
msgstr "Main droite sur do, ré, mi, fa et sol avec les doigts 1 à 5. Jouez la note indiquée avec son doigt."

#: escalas/catalog_strings.py
msgid "Teclas blancas sin ayuda"
msgstr "Touches blanches sans aide"

#: escalas/catalog_strings.py
msgid "Ahora la tecla solo se ilumina si te equivocas. Prueba en dos octavas."
msgstr "Maintenant la touche ne s'allume que si vous vous trompez. Essayez sur deux octaves."

#: escalas/catalog_strings.py
msgid "Las teclas negras"
msgstr "Les touches noires"

#: escalas/catalog_strings.py
msgid "Sostenidos (♯) y bemoles (♭): cada tecla negra tiene dos nombres. Búscalas por su vecina blanca."
msgstr "Dièses (♯) et bémols (♭) : chaque touche noire a deux noms. Trouvez-les grâce à leur voisine blanche."

#: escalas/catalog_strings.py
msgid "Tu primera lectura: de Do a Sol"
msgstr "Votre première lecture : du do au sol"

#: escalas/catalog_strings.py
msgid "Cinco notas en clave de sol, del Do central al Sol, para empezar a leer el pentagrama."
msgstr "Cinq notes en clé de sol, du do central au sol, pour commencer à lire la portée."

#: escalas/catalog_strings.py
msgid "Tu primera melodía"
msgstr "Votre première mélodie"

#: escalas/catalog_strings.py
msgid "Frases cortas de cuatro notas que suben y bajan de a poco."
msgstr "Courtes phrases de quatre notes qui montent et descendent peu à peu."

#: escalas/catalog_strings.py
msgid "Tus primeros acordes: Do y Sol"
msgstr "Vos premiers accords : do et sol"

#: escalas/catalog_strings.py
msgid "Toca tres notas a la vez: Do mayor y Sol mayor, con las teclas marcadas."
msgstr "Jouez trois notes à la fois : do majeur et sol majeur, avec les touches indiquées."

#: escalas/forms.py
msgid "La precisión no puede superar 100."
msgstr "La précision ne peut pas dépasser 100."

#: escalas/forms.py
msgid "Nombre de la canción"
msgstr "Nom de la chanson"

#: escalas/forms.py
msgid "Autor"
msgstr "Auteur"

#: escalas/forms.py
msgid "Categoría"
msgstr "Catégorie"

#: escalas/forms.py
msgid "Partitura (MIDI o MusicXML)"
msgstr "Partition (MIDI ou MusicXML)"

#: escalas/forms.py
msgid "Pista mano derecha"
msgstr "Piste main droite"

#: escalas/forms.py
msgid "Pista mano izquierda"
msgstr "Piste main gauche"

#: escalas/forms.py
msgid "El nombre necesita al menos una letra o un número."
msgstr "Le nom doit contenir au moins une lettre ou un chiffre."

#: escalas/forms.py
msgid "El archivo no puede pasar de 2 MB."
msgstr "Le fichier ne peut pas dépasser 2 Mo."

#: escalas/forms.py
msgid "Avanzado: la versión completa (se generan también las demás)"
msgstr "Avancé : la version complète (les autres niveaux sont générés aussi)"

#: escalas/forms.py
msgid "Solo el nivel Intermedio, escrito a mano"
msgstr "Uniquement le niveau Intermédiaire, écrit à la main"

#: escalas/forms.py
msgid "Solo el nivel Básico, escrito a mano"
msgstr "Uniquement le niveau Basique, écrit à la main"

#: escalas/forms.py
msgid "Qué versión es"
msgstr "De quelle version s'agit-il"

#: escalas/midi_import.py
msgid "No es un archivo MIDI (falta la cabecera MThd)."
msgstr "Ce n'est pas un fichier MIDI (l'en-tête MThd est absent)."

#: escalas/midi_import.py
msgid "Los MIDI con división SMPTE no están soportados."
msgstr "Les fichiers MIDI à division SMPTE ne sont pas pris en charge."

#: escalas/midi_import.py
msgid "Pista MIDI mal formada."
msgstr "Piste MIDI mal formée."

#: escalas/midi_import.py
msgid "Evento MIDI sin estado."
msgstr "Événement MIDI sans statut."

#: escalas/midi_import.py
msgid "El MIDI no tiene notas en las pistas elegidas."
msgstr "Le fichier MIDI n'a pas de notes dans les pistes choisies."

#: escalas/models.py
msgid "Básico"
msgstr "Basique"

#: escalas/models.py
msgid "Intermedio"
msgstr "Intermédiaire"

#: escalas/models.py
msgid "Avanzado"
msgstr "Avancé"

#: escalas/models.py
msgid "Clásica"
msgstr "Classique"

#: escalas/models.py
msgid "Cristiana"
msgstr "Chrétienne"

#: escalas/models.py
msgid "Popular"
msgstr "Populaire"

#: escalas/musicxml_import.py
msgid "No se pudo abrir el archivo .mxl."
msgstr "Impossible d'ouvrir le fichier .mxl."

#: escalas/musicxml_import.py
msgid "El archivo MusicXML está mal formado."
msgstr "Le fichier MusicXML est mal formé."

#: escalas/musicxml_import.py
msgid "Solo se admite MusicXML «partwise» (el que exportan MuseScore, Finale y Sibelius)."
msgstr "Seul le MusicXML « partwise » est pris en charge (celui qu'exportent MuseScore, Finale et Sibelius)."

#: escalas/musicxml_import.py
msgid "El MusicXML no tiene partes."
msgstr "Le MusicXML n'a aucune partie."

#: escalas/musicxml_import.py
msgid "El MusicXML no tiene notas."
msgstr "Le MusicXML n'a aucune note."

#: escalas/song_import.py
#, python-format
msgid "%(song)s · %(level)s: %(rh)d notas en la derecha, %(lh)d en la izquierda, %(tempo)d BPM, armadura %(key)d."
