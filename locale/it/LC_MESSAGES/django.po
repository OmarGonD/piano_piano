msgstr "Il file non può superare i 2 MB."

#: escalas/midi_import.py
msgid "No es un archivo MIDI (falta la cabecera MThd)."
msgstr "Non è un file MIDI (manca l'intestazione MThd)."

#: escalas/midi_import.py
msgid "Los MIDI con división SMPTE no están soportados."
msgstr "I file MIDI con divisione SMPTE non sono supportati."

#: escalas/midi_import.py
msgid "Pista MIDI mal formada."
msgstr "Traccia MIDI malformata."

#: escalas/midi_import.py
msgid "Evento MIDI sin estado."
msgstr "Evento MIDI senza stato."

#: escalas/midi_import.py
msgid "El MIDI no tiene notas en las pistas elegidas."
msgstr "Il file MIDI non ha note nelle tracce scelte."

