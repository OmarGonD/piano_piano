msgstr "Il file MusicXML è malformato."

#: escalas/musicxml_import.py
msgid "Solo se admite MusicXML «partwise» (el que exportan MuseScore, Finale y Sibelius)."
msgstr "È supportato solo il MusicXML «partwise» (quello esportato da MuseScore, Finale e Sibelius)."

#: escalas/musicxml_import.py
msgid "El MusicXML no tiene partes."
msgstr "Il MusicXML non ha parti."

#: escalas/musicxml_import.py
msgid "El MusicXML no tiene notas."
msgstr "Il MusicXML non ha note."

#: escalas/song_import.py
#, python-format
msgid "%(song)s · %(level)s: %(rh)d notas en la derecha, %(lh)d en la izquierda, %(tempo)d BPM, armadura %(key)d."
msgstr "%(song)s · %(level)s: %(rh)d note nella destra, %(lh)d nella sinistra, %(tempo)d BPM, armatura %(key)d."

#: escalas/song_import.py
#, python-format
