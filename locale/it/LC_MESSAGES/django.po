#: cuentas/forms.py
msgid "Nombre"
msgstr "Nome"

#: cuentas/forms.py
msgid "Correo electrónico"
msgstr "E-mail"

#: cuentas/forms.py
msgid "Ya hay una cuenta con este correo."
msgstr "Esiste già un account con questa e-mail."

#: cuentas/forms.py
msgid "Tu cuenta aún no está activada. Cuando la activen podrás entrar."
msgstr "Il tuo account non è ancora attivo. Potrai accedere quando verrà attivato."

#: cuentas/models.py escalas/templates/escalas/song.html
msgid "Partitura"
msgstr "Spartito"

#: cuentas/models.py escalas/templates/escalas/song.html
msgid "Lluvia de notas"
msgstr "Pioggia di note"

#: cuentas/models.py
msgid "vista de las canciones"
msgstr "vista dei brani"

#: cuentas/models.py
msgid "Partitura: las notas en el pentagrama. Lluvia de notas: las notas caen hacia su tecla."
msgstr "Spartito: le note sul pentagramma. Pioggia di note: le note cadono verso il loro tasto."

#: cuentas/templates/cuentas/preferences.html
msgid "Preferencias · Piano"
msgstr "Preferenze · Piano"

#: cuentas/templates/cuentas/preferences.html
msgid "Preferencias"
msgstr "Preferenze"

#: cuentas/templates/cuentas/preferences.html
msgid "Las notas en el pentagrama, como en una partitura."
msgstr "Le note sul pentagramma, come in uno spartito."

#: cuentas/templates/cuentas/preferences.html
msgid "Las notas caen hacia su tecla del teclado, con un color para cada mano."
msgstr "Le note cadono verso il loro tasto sulla tastiera, con un colore per ogni mano."

#: cuentas/templates/cuentas/preferences.html
msgid "Guardar"
msgstr "Salva"

#: cuentas/templates/cuentas/register.html
msgid "Registro · Piano"
msgstr "Registrazione · Piano"

#: cuentas/templates/cuentas/register.html
#, python-format
msgid "¡Cuenta creada, %(name)s!"
msgstr "Account creato, %(name)s!"

#: cuentas/templates/cuentas/register.html
#, python-format
msgid "Tu cuenta <b>%(user)s</b> está pendiente de activación. Para activarla, envía un correo a:"
msgstr "Il tuo account <b>%(user)s</b> è in attesa di attivazione. Per attivarlo, invia un'e-mail a:"

#: cuentas/templates/cuentas/register.html
msgid "con tu nombre de usuario. Puedes usar este botón, que deja el mensaje escrito:"
msgstr "con il tuo nome utente. Puoi usare questo pulsante, che prepara già il messaggio:"

#: cuentas/templates/cuentas/register.html
msgid "Escribir el correo"
msgstr "Scrivi l'e-mail"

#: cuentas/templates/cuentas/register.html
#, python-format
msgid "Cuando tu cuenta esté activa podrás <a href=\"%(login_url)s\">entrar</a>."
msgstr "Quando il tuo account sarà attivo potrai <a href=\"%(login_url)s\">accedere</a>."

#: cuentas/templates/cuentas/register.html
msgid "Crear cuenta"
msgstr "Crea account"

#: cuentas/templates/cuentas/register.html
#, python-format
msgid "Después de registrarte, envía un correo a <b>%(admin_email)s</b> para que activen tu cuenta."
msgstr "Dopo la registrazione, invia un'e-mail a <b>%(admin_email)s</b> per far attivare il tuo account."

#: cuentas/templates/cuentas/register.html
msgid "Registrarme"
msgstr "Registrami"

#: cuentas/templates/cuentas/register.html
msgid "¿Ya tienes cuenta?"
msgstr "Hai già un account?"

#: cuentas/templates/cuentas/register.html
#: cuentas/templates/registration/login.html
#: escalas/templates/escalas/_nav.html
msgid "Entrar"
msgstr "Accedi"

#: cuentas/templates/registration/login.html
msgid "Entrar · Piano"
msgstr "Accedi · Piano"

#: cuentas/templates/registration/login.html
msgid "Tu avance se guarda en tu cuenta: escalas, módulos y canciones."
msgstr "I tuoi progressi vengono salvati nel tuo account: scale, moduli e brani."

#: cuentas/templates/registration/login.html
msgid "¿No tienes cuenta?"
msgstr "Non hai un account?"

#: cuentas/templates/registration/login.html
msgid "Regístrate"
msgstr "Registrati"

#: cuentas/views.py
#, python-format
msgid "Activar cuenta: %(user)s"
msgstr "Attiva account: %(user)s"

#: cuentas/views.py
#, python-format
msgid ""
"Hola, me registré en la app de piano y quisiera activar mi cuenta.\n"
"\n"
"Usuario: %(user)s\n"
"Nombre: %(name)s\n"
"Correo: %(email)s\n"
msgstr ""

#: cuentas/views.py
msgid "Preferencias guardadas."
msgstr "Preferenze salvate."

#: escalas/catalog_strings.py
msgid "Acompaña canciones con acordes."
msgstr "Accompagna i brani con gli accordi."

#: escalas/catalog_strings.py
msgid "Acordes con sostenidos y bemoles"
msgstr "Accordi con diesis e bemolle"

#: escalas/catalog_strings.py
msgid "Acordes de séptima"
msgstr "Accordi di settima"

#: escalas/catalog_strings.py
msgid "Acordes de tensión y color para dar variedad a un acompañamiento."
msgstr "Accordi di tensione e colore per dare varietà a un accompagnamento."

#: escalas/catalog_strings.py
msgid "Acordes mayores"
msgstr "Accordi maggiori"

#: escalas/catalog_strings.py
msgid "Acordes menores"
msgstr "Accordi minori"

#: escalas/catalog_strings.py
msgid "Aprende a leer el pentagrama nota a nota, hasta tocar piezas escritas."
msgstr "Impara a leggere il pentagramma nota per nota, fino a suonare brani scritti."

#: escalas/catalog_strings.py
msgid "Aprende acordes, inversiones y progresiones para tocar con otros músicos."
msgstr "Impara accordi, rivolti e progressioni per suonare con altri musicisti."

#: escalas/catalog_strings.py
msgid "Arpegios de dos octavas en corcheas y bajo en negras, con el final en acordes."
msgstr "Arpeggi di due ottave in crome e basso in semiminime, con il finale in accordi."

#: escalas/catalog_strings.py
msgid "Banda"
msgstr "Band"

#: escalas/catalog_strings.py
msgid "Blues de 12 compases"
msgstr "Blues di 12 battute"

#: escalas/catalog_strings.py
msgid "Cada nota aparece en su clave, sol o fa, como en una partitura de piano. Cambia de lectura sin pausa."
msgstr "Ogni nota appare nella sua chiave, di violino o di basso, come in uno spartito per pianoforte. Cambia lettura senza pause."

#: escalas/catalog_strings.py
msgid "Canción de 1968 con derechos de autor vigentes: importa tu partitura en MIDI y la app crea las tres versiones."
msgstr "Canzone del 1968 ancora coperta da diritti d'autore: importa il tuo spartito MIDI e l'app crea le tre versioni."

#: escalas/catalog_strings.py
msgid "Clave de fa: las notas del pentagrama"
msgstr "Chiave di basso: le note del pentagramma"

#: escalas/catalog_strings.py
msgid "Clave de fa: líneas adicionales"
msgstr "Chiave di basso: tagli addizionali"

#: escalas/catalog_strings.py
msgid "Clave de sol: las notas del pentagrama"
msgstr "Chiave di violino: le note del pentagramma"

#: escalas/catalog_strings.py
msgid "Clave de sol: líneas adicionales"
msgstr "Chiave di violino: tagli addizionali"

#: escalas/catalog_strings.py
msgid "Con segunda voz y bajo arpegiado"
msgstr "Con seconda voce e basso arpeggiato"

#: escalas/catalog_strings.py
msgid "Del Do2 grave hasta el Mi4, que se escribe sobre el pentagrama de fa."
msgstr "Dal Do2 grave al Mi4, che si scrive sopra il pentagramma di basso."

#: escalas/catalog_strings.py
msgid "Disminuidos, aumentados y suspendidos"
msgstr "Diminuiti, aumentati e sospesi"

#: escalas/catalog_strings.py
msgid "Do, Fa, Sol, Re, La y Mi: los acordes más usados en canciones. Verás sus notas en el teclado."
msgstr "Do, Fa, Sol, Re, La e Mi: gli accordi più usati nelle canzoni. Vedrai le loro note sulla tastiera."

#: escalas/catalog_strings.py
msgid "Doxología"
msgstr "Dossologia"

#: escalas/catalog_strings.py
msgid "Dórica"
msgstr "Dorica"

#: escalas/catalog_strings.py
msgid "El famoso bajo en ciclo de quintas de la Suite en sol menor HWV 432. Aprende primero la mano derecha, luego la izquierda y al final las dos juntas."
msgstr "Il celebre basso a ciclo di quinte della Suite in sol minore HWV 432. Impara prima la mano destra, poi la sinistra e infine le due insieme."

#: escalas/catalog_strings.py
msgid "El himno más cantado del mundo (Amazing Grace), en compás de tres."
msgstr "L'inno più cantato al mondo (Amazing Grace), in tempo di tre."

#: escalas/catalog_strings.py
msgid "El sonido más oscuro: La menor, Re menor, Mi menor y compañía."
msgstr "Il suono più scuro: La minore, Re minore, Mi minore e compagnia."

#: escalas/catalog_strings.py
msgid "El villancico de Navidad por excelencia, con su suave balanceo en tres."
msgstr "Il canto natalizio per eccellenza, con il suo dolce dondolio in tre."

#: escalas/catalog_strings.py
msgid "Encadena los tres acordes principales de una tonalidad, en Do y en Sol."
msgstr "Concatena i tre accordi principali di una tonalità, in Do e in Sol."

#: escalas/catalog_strings.py
msgid "Frases de ocho notas con saltos amplios y alteraciones en clave de sol."
msgstr "Frasi di otto note con salti ampi e alterazioni in chiave di violino."

#: escalas/catalog_strings.py
msgid "Frases de ocho notas para la mano izquierda, con saltos y alteraciones."
msgstr "Frasi di otto note per la mano sinistra, con salti e alterazioni."

#: escalas/catalog_strings.py
msgid "Frases por grados conjuntos"
msgstr "Frasi per gradi congiunti"

#: escalas/catalog_strings.py
msgid "Frigia"
msgstr "Frigia"

#: escalas/catalog_strings.py
msgid "Generada automáticamente: la melodía y un bajo por medio compás."
msgstr "Generata automaticamente: la melodia e un basso ogni mezza battuta."

#: escalas/catalog_strings.py
msgid "Generada automáticamente: teclas blancas, notas largas y una nota a la vez por mano."
msgstr "Generata automaticamente: tasti bianchi, note lunghe e una nota alla volta per mano."

#: escalas/catalog_strings.py
msgid "Himno de la alegría"
msgstr "Inno alla gioia"

#: escalas/catalog_strings.py
msgid "Interestelar"
msgstr "Interstellar"

#: escalas/catalog_strings.py
msgid "La cadencia básica del jazz, con acordes de séptima, en Do, Fa, Si♭ y Mi♭."
msgstr "La cadenza di base del jazz, con accordi di settima, in Do, Fa, Si♭ e Mi♭."

#: escalas/catalog_strings.py
msgid "La clave de la mano izquierda: de Sol2 a La3, en líneas y espacios."
msgstr "La chiave della mano sinistra: dal Sol2 al La3, su righe e spazi."

#: escalas/catalog_strings.py
msgid "La forma completa del blues con acordes de séptima, en Do y en Sol."
msgstr "La forma completa del blues con accordi di settima, in Do e in Sol."

#: escalas/catalog_strings.py
msgid "La melodía completa con la fundamental de cada acorde en la izquierda."
msgstr "La melodia completa con la fondamentale di ogni accordo nella sinistra."

#: escalas/catalog_strings.py
msgid "La melodía de la Novena sinfonía, cantada en iglesias como «Jubilosos te adoramos»."
msgstr "La melodia della Nona Sinfonia, cantata nelle chiese come «Jubilosos te adoramos»."

#: escalas/catalog_strings.py
msgid "La progresión de cientos de canciones, en cuatro tonalidades."
msgstr "La progressione di centinaia di canzoni, in quattro tonalità."

#: escalas/catalog_strings.py
msgid "La progresión pop: I–V–vi–IV"
msgstr "La progressione pop: I–V–vi–IV"

#: escalas/catalog_strings.py
msgid "Las dos claves alternadas"
msgstr "Le due chiavi alternate"

#: escalas/catalog_strings.py
msgid "Las mismas notas de la clave de sol, ahora con ♯ y ♭. Fíjate en la alteración antes de tocar."
msgstr "Le stesse note della chiave di violino, ora con ♯ e ♭. Guarda l'alterazione prima di suonare."

#: escalas/catalog_strings.py
msgid "Lee frases cortas de cinco notas que se mueven por notas vecinas, como en una melodía."
msgstr "Leggi brevi frasi di cinque note che si muovono per note vicine, come in una melodia."

#: escalas/catalog_strings.py
msgid "Lee partituras y toca música clásica."
msgstr "Leggi gli spartiti e suona musica classica."

#: escalas/catalog_strings.py
msgid "Lidia"
msgstr "Lidia"

#: escalas/catalog_strings.py
msgid "Locria"
msgstr "Locria"

#: escalas/catalog_strings.py escalas/templates/escalas/index.html
msgid "Mayor"
msgstr "Maggiore"

#: escalas/catalog_strings.py
msgid "Melodía en Do"
msgstr "Melodia in Do"

#: escalas/catalog_strings.py
msgid "Menor armónica"
msgstr "Minore armonica"

#: escalas/catalog_strings.py
msgid "Menor melódica"
msgstr "Minore melodica"

#: escalas/catalog_strings.py
msgid "Menor natural"
msgstr "Minore naturale"

#: escalas/catalog_strings.py
msgid "Mixolidia"
msgstr "Misolidia"

#: escalas/catalog_strings.py
msgid "Noche de paz"
msgstr "Astro del ciel"

#: escalas/catalog_strings.py
msgid "Pentatónica mayor"
msgstr "Pentatonica maggiore"

#: escalas/catalog_strings.py
msgid "Pentatónica menor"
msgstr "Pentatonica minore"

#: escalas/catalog_strings.py
msgid "Primera vista en clave de fa"
msgstr "Lettura a prima vista in chiave di basso"

#: escalas/catalog_strings.py
msgid "Primera vista: saltos y alteraciones"
msgstr "Lettura a prima vista: salti e alterazioni"

#: escalas/catalog_strings.py
msgid "Reconoce las nueve notas que caen en las líneas y espacios, de Mi4 a Fa5, y tócalas en el piano."
msgstr "Riconosci le nove note che cadono su righe e spazi, dal Mi4 al Fa5, e suonale al pianoforte."

#: escalas/catalog_strings.py
msgid "Segunda voz en los tiempos fuertes y bajo arpegiado en negras."
msgstr "Seconda voce sui tempi forti e basso arpeggiato in semiminime."

#: escalas/catalog_strings.py
msgid "Si♭, Mi♭, La♭, Fa♯ menor… Ahora las notas solo aparecen si te equivocas."
msgstr "Si♭, Mi♭, La♭, Fa♯ minore… Ora le note compaiono solo se sbagli."

#: escalas/catalog_strings.py
msgid "Solista"
msgstr "Solista"

#: escalas/catalog_strings.py
msgid "Solo teclas blancas: la melodía en notas largas y una nota de bajo por compás."
msgstr "Solo tasti bianchi: la melodia in note lunghe e una nota di basso per battuta."

#: escalas/catalog_strings.py
msgid "Sostenidos y bemoles"
msgstr "Diesis e bemolle"

#: escalas/catalog_strings.py
msgid "Sublime gracia"
msgstr "Amazing Grace"

#: escalas/catalog_strings.py
msgid "Suma el Do central y las notas que se salen del pentagrama por arriba, hasta La5."
msgstr "Aggiungi il Do centrale e le note che escono dal pentagramma verso l'alto, fino al La5."

#: escalas/catalog_strings.py
msgid "Séptima de dominante, menor séptima y séptima mayor: el color del pop, el soul y el jazz."
msgstr "Settima di dominante, settima minore e settima maggiore: il colore del pop, del soul e del jazz."

#: escalas/catalog_strings.py
msgid "Tu primera progresión: I–IV–V"
msgstr "La tua prima progressione: I–IV–V"

#: escalas/catalog_strings.py
msgid "baja natural"
msgstr "discendente naturale"

#: escalas/catalog_strings.py
msgid "ii–V–I en cuatro tonalidades"
msgstr "ii–V–I in quattro tonalità"

#: escalas/catalog_strings.py
msgid "«A Dios el Padre celestial»: el antiguo salmo 100, en notas largas y solemnes."
msgstr "«Lodate Dio, Padre celeste»: l'antico salmo 100, in note lunghe e solenni."

#: escalas/catalog_strings.py
msgid "Jean Renard y Pierre Delanoë (canta Sylvie Vartan)"
msgstr "Jean Renard e Pierre Delanoë (cantata da Sylvie Vartan)"

#: escalas/catalog_strings.py
msgid "Melodía tradicional «New Britain» (1829)"
msgstr "Melodia tradizionale «New Britain» (1829)"

#: escalas/forms.py
msgid "La precisión no puede superar 100."
msgstr "La precisione non può superare 100."

