msgid "No se pudo acceder a MIDI. Revisa el permiso en Chrome."
msgstr "Impossibile accedere al MIDI. Controlla l'autorizzazione in Chrome."

#: escalas/static/escalas/js/midiin.js
msgid "Teclado conectado (%(n)s entrada)."
msgid_plural "Teclado conectado (%(n)s entradas)."
msgstr[0] "Tastiera collegata (%(n)s ingresso)."
msgstr[1] "Tastiera collegata (%(n)s ingressi)."

