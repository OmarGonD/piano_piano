#: escalas/templates/escalas/base.html
msgid "Escalas · práctica de piano"
msgstr "Scales · piano practice"

#: escalas/templates/escalas/home.html
msgid "Piano · elige tu camino"
msgstr "Piano · choose your path"

#: escalas/templates/escalas/home.html
msgid "¿Cómo quieres tocar?"
msgstr "How do you want to play?"

#: escalas/templates/escalas/home.html
msgid "Elige un camino. Puedes cambiar cuando quieras; tu progreso se guarda en cada uno."
msgstr "Choose a path. You can switch whenever you like; your progress is saved in each one."

#: escalas/templates/escalas/home.html
#, python-format
msgid "%(n)s módulo"
msgid_plural "%(n)s módulos"
msgstr[0] "%(n)s module"
msgstr[1] "%(n)s modules"

#: escalas/templates/escalas/home.html
msgid "Próximamente"
msgstr "Coming soon"

#: escalas/templates/escalas/home.html
msgid "Piezas completas en tres versiones: mano derecha, izquierda y juntas, con puntos y estrellas."
msgstr "Complete pieces in three versions: right hand, left hand and both together, with points and stars."

#: escalas/templates/escalas/home.html
msgid "Escalas, círculo armónico y afinador, sin orden fijo."
msgstr "Scales, chord progressions and tuner, in any order."

