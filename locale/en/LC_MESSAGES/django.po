#: cuentas/views.py
msgid "Preferencias guardadas."
msgstr "Preferences saved."

#: escalas/catalog_strings.py
msgid "Acompaña canciones con acordes."
msgstr "Accompany songs with chords."

#: escalas/catalog_strings.py
msgid "Acordes con sostenidos y bemoles"
msgstr "Chords with sharps and flats"

#: escalas/catalog_strings.py
msgid "Acordes de séptima"
msgstr "Seventh chords"

#: escalas/catalog_strings.py
msgid "Acordes de tensión y color para dar variedad a un acompañamiento."
msgstr "Chords of tension and colour to add variety to an accompaniment."

#: escalas/catalog_strings.py
msgid "Acordes mayores"
msgstr "Major chords"

#: escalas/catalog_strings.py
msgid "Acordes menores"
msgstr "Minor chords"

#: escalas/catalog_strings.py
msgid "Aprende a leer el pentagrama nota a nota, hasta tocar piezas escritas."
msgstr "Learn to read the staff note by note, until you can play written pieces."

#: escalas/catalog_strings.py
msgid "Aprende acordes, inversiones y progresiones para tocar con otros músicos."
msgstr "Learn chords, inversions and progressions to play with other musicians."

#: escalas/catalog_strings.py
msgid "Arpegios de dos octavas en corcheas y bajo en negras, con el final en acordes."
msgstr "Two-octave arpeggios in eighth notes with a quarter-note bass, ending in chords."

#: escalas/catalog_strings.py
msgid "Banda"
msgstr "Band"

#: escalas/catalog_strings.py
msgid "Blues de 12 compases"
msgstr "12-bar blues"

#: escalas/catalog_strings.py
msgid "Cada nota aparece en su clave, sol o fa, como en una partitura de piano. Cambia de lectura sin pausa."
msgstr "Each note appears in its own clef, treble or bass, as in piano sheet music. Switch reading without pausing."

#: escalas/catalog_strings.py
msgid "Canción de 1968 con derechos de autor vigentes: importa tu partitura en MIDI y la app crea las tres versiones."
msgstr "A 1968 song still under copyright: import your MIDI score and the app creates the three versions."

#: escalas/catalog_strings.py
msgid "Clave de fa: las notas del pentagrama"
msgstr "Bass clef: the notes on the staff"

#: escalas/catalog_strings.py
msgid "Clave de fa: líneas adicionales"
msgstr "Bass clef: ledger lines"

#: escalas/catalog_strings.py
msgid "Clave de sol: las notas del pentagrama"
msgstr "Treble clef: the notes on the staff"

#: escalas/catalog_strings.py
msgid "Clave de sol: líneas adicionales"
msgstr "Treble clef: ledger lines"

#: escalas/catalog_strings.py
msgid "Con segunda voz y bajo arpegiado"
msgstr "With a second voice and arpeggiated bass"

#: escalas/catalog_strings.py
msgid "Del Do2 grave hasta el Mi4, que se escribe sobre el pentagrama de fa."
msgstr "From the low C2 up to E4, written above the bass-clef staff."

#: escalas/catalog_strings.py
msgid "Disminuidos, aumentados y suspendidos"
msgstr "Diminished, augmented and suspended"

#: escalas/catalog_strings.py
msgid "Do, Fa, Sol, Re, La y Mi: los acordes más usados en canciones. Verás sus notas en el teclado."
msgstr "C, F, G, D, A and E: the chords most used in songs. You will see their notes on the keyboard."

#: escalas/catalog_strings.py
msgid "Doxología"
msgstr "Doxology"

#: escalas/catalog_strings.py
msgid "Dórica"
msgstr "Dorian"

#: escalas/catalog_strings.py
msgid "El famoso bajo en ciclo de quintas de la Suite en sol menor HWV 432. Aprende primero la mano derecha, luego la izquierda y al final las dos juntas."
msgstr "The famous circle-of-fifths bass from the Suite in G minor, HWV 432. Learn the right hand first, then the left, and finally both together."

#: escalas/catalog_strings.py
msgid "El himno más cantado del mundo (Amazing Grace), en compás de tres."
msgstr "The most sung hymn in the world (Amazing Grace), in three-four time."

#: escalas/catalog_strings.py
msgid "El sonido más oscuro: La menor, Re menor, Mi menor y compañía."
msgstr "The darker sound: A minor, D minor, E minor and company."

#: escalas/catalog_strings.py
msgid "El villancico de Navidad por excelencia, con su suave balanceo en tres."
msgstr "The Christmas carol par excellence, with its gentle three-beat sway."

#: escalas/catalog_strings.py
msgid "Encadena los tres acordes principales de una tonalidad, en Do y en Sol."
msgstr "Chain the three main chords of a key, in C and in G."

#: escalas/catalog_strings.py
msgid "Frases de ocho notas con saltos amplios y alteraciones en clave de sol."
msgstr "Eight-note phrases with wide leaps and accidentals in treble clef."

#: escalas/catalog_strings.py
msgid "Frases de ocho notas para la mano izquierda, con saltos y alteraciones."
msgstr "Eight-note phrases for the left hand, with leaps and accidentals."

#: escalas/catalog_strings.py
msgid "Frases por grados conjuntos"
msgstr "Stepwise phrases"

#: escalas/catalog_strings.py
msgid "Frigia"
msgstr "Phrygian"

#: escalas/catalog_strings.py
msgid "Generada automáticamente: la melodía y un bajo por medio compás."
msgstr "Generated automatically: the melody and a bass note every half bar."

#: escalas/catalog_strings.py
msgid "Generada automáticamente: teclas blancas, notas largas y una nota a la vez por mano."
msgstr "Generated automatically: white keys, long notes and one note at a time per hand."

#: escalas/catalog_strings.py
msgid "Himno de la alegría"
msgstr "Ode to Joy"

#: escalas/catalog_strings.py
msgid "Interestelar"
msgstr "Interstellar"

#: escalas/catalog_strings.py
msgid "La cadencia básica del jazz, con acordes de séptima, en Do, Fa, Si♭ y Mi♭."
msgstr "The basic jazz cadence, with seventh chords, in C, F, B♭ and E♭."

#: escalas/catalog_strings.py
msgid "La clave de la mano izquierda: de Sol2 a La3, en líneas y espacios."
msgstr "The left-hand clef: from G2 to A3, on lines and spaces."

#: escalas/catalog_strings.py
msgid "La forma completa del blues con acordes de séptima, en Do y en Sol."
msgstr "The full blues form with seventh chords, in C and in G."

#: escalas/catalog_strings.py
msgid "La melodía completa con la fundamental de cada acorde en la izquierda."
msgstr "The full melody with the root of each chord in the left hand."

#: escalas/catalog_strings.py
msgid "La melodía de la Novena sinfonía, cantada en iglesias como «Jubilosos te adoramos»."
msgstr "The melody of the Ninth Symphony, sung in churches as “Joyful, joyful, we adore Thee”."

#: escalas/catalog_strings.py
msgid "La progresión de cientos de canciones, en cuatro tonalidades."
msgstr "The progression behind hundreds of songs, in four keys."

#: escalas/catalog_strings.py
msgid "La progresión pop: I–V–vi–IV"
msgstr "The pop progression: I–V–vi–IV"

#: escalas/catalog_strings.py
msgid "Las dos claves alternadas"
msgstr "Both clefs alternating"

#: escalas/catalog_strings.py
msgid "Las mismas notas de la clave de sol, ahora con ♯ y ♭. Fíjate en la alteración antes de tocar."
msgstr "The same treble-clef notes, now with ♯ and ♭. Look at the accidental before you play."

#: escalas/catalog_strings.py
msgid "Lee frases cortas de cinco notas que se mueven por notas vecinas, como en una melodía."
msgstr "Read short five-note phrases that move by neighbouring notes, like in a melody."

#: escalas/catalog_strings.py
msgid "Lee partituras y toca música clásica."
msgstr "Read sheet music and play classical music."

#: escalas/catalog_strings.py
msgid "Lidia"
msgstr "Lydian"

#: escalas/catalog_strings.py
msgid "Locria"
msgstr "Locrian"

#: escalas/catalog_strings.py escalas/templates/escalas/index.html
msgid "Mayor"
msgstr "Major"

#: escalas/catalog_strings.py
msgid "Melodía en Do"
msgstr "Melody in C"

#: escalas/catalog_strings.py
msgid "Menor armónica"
msgstr "Harmonic minor"

#: escalas/catalog_strings.py
msgid "Menor melódica"
msgstr "Melodic minor"

#: escalas/catalog_strings.py
msgid "Menor natural"
msgstr "Natural minor"

#: escalas/catalog_strings.py
msgid "Mixolidia"
msgstr "Mixolydian"

#: escalas/catalog_strings.py
msgid "Noche de paz"
msgstr "Silent Night"

#: escalas/catalog_strings.py
msgid "Pentatónica mayor"
msgstr "Major pentatonic"

#: escalas/catalog_strings.py
msgid "Pentatónica menor"
msgstr "Minor pentatonic"

#: escalas/catalog_strings.py
msgid "Primera vista en clave de fa"
msgstr "Sight-reading in bass clef"

#: escalas/catalog_strings.py
msgid "Primera vista: saltos y alteraciones"
msgstr "Sight-reading: leaps and accidentals"

#: escalas/catalog_strings.py
msgid "Reconoce las nueve notas que caen en las líneas y espacios, de Mi4 a Fa5, y tócalas en el piano."
msgstr "Recognise the nine notes that fall on the lines and spaces, from E4 to F5, and play them on the piano."

#: escalas/catalog_strings.py
msgid "Segunda voz en los tiempos fuertes y bajo arpegiado en negras."
msgstr "A second voice on the strong beats and an arpeggiated bass in quarter notes."

#: escalas/catalog_strings.py
msgid "Si♭, Mi♭, La♭, Fa♯ menor… Ahora las notas solo aparecen si te equivocas."
msgstr "B♭, E♭, A♭, F♯ minor… Now the notes only appear if you make a mistake."

#: escalas/catalog_strings.py
msgid "Solista"
msgstr "Soloist"

#: escalas/catalog_strings.py
msgid "Solo teclas blancas: la melodía en notas largas y una nota de bajo por compás."
msgstr "White keys only: the melody in long notes and one bass note per bar."

#: escalas/catalog_strings.py
msgid "Sostenidos y bemoles"
msgstr "Sharps and flats"

#: escalas/catalog_strings.py
msgid "Sublime gracia"
msgstr "Amazing Grace"

#: escalas/catalog_strings.py
msgid "Suma el Do central y las notas que se salen del pentagrama por arriba, hasta La5."
msgstr "Add middle C and the notes that go above the staff, up to A5."

#: escalas/catalog_strings.py
msgid "Séptima de dominante, menor séptima y séptima mayor: el color del pop, el soul y el jazz."
msgstr "Dominant seventh, minor seventh and major seventh: the colour of pop, soul and jazz."

#: escalas/catalog_strings.py
msgid "Tu primera progresión: I–IV–V"
msgstr "Your first progression: I–IV–V"

#: escalas/catalog_strings.py
msgid "baja natural"
msgstr "descending natural"

#: escalas/catalog_strings.py
msgid "ii–V–I en cuatro tonalidades"
msgstr "ii–V–I in four keys"

#: escalas/catalog_strings.py
msgid "«A Dios el Padre celestial»: el antiguo salmo 100, en notas largas y solemnes."
msgstr "“Praise God, from whom all blessings flow”: the old Psalm 100 tune, in long, solemn notes."

#: escalas/catalog_strings.py
msgid "Jean Renard y Pierre Delanoë (canta Sylvie Vartan)"
msgstr "Jean Renard and Pierre Delanoë (sung by Sylvie Vartan)"

#: escalas/catalog_strings.py
msgid "Melodía tradicional «New Britain» (1829)"
msgstr "Traditional melody “New Britain” (1829)"

#: escalas/forms.py
msgid "La precisión no puede superar 100."
msgstr "Accuracy cannot exceed 100."

#: escalas/forms.py
msgid "Nombre de la canción"
msgstr "Song name"

#: escalas/forms.py
msgid "Autor"
msgstr "Author"

#: escalas/forms.py
msgid "Categoría"
msgstr "Category"

#: escalas/forms.py
msgid "Partitura (MIDI o MusicXML)"
msgstr "Score (MIDI or MusicXML)"

#: escalas/forms.py
msgid "Pista mano derecha"
msgstr "Right-hand track"

#: escalas/forms.py
msgid "Pista mano izquierda"
msgstr "Left-hand track"

#: escalas/forms.py
msgid "El nombre necesita al menos una letra o un número."
msgstr "The name needs at least one letter or number."

#: escalas/forms.py
msgid "El archivo no puede pasar de 2 MB."
msgstr "The file cannot be larger than 2 MB."

#: escalas/midi_import.py
msgid "No es un archivo MIDI (falta la cabecera MThd)."
msgstr "This is not a MIDI file (the MThd header is missing)."

#: escalas/midi_import.py
msgid "Los MIDI con división SMPTE no están soportados."
msgstr "MIDI files with SMPTE time division are not supported."

#: escalas/midi_import.py
msgid "Pista MIDI mal formada."
msgstr "Malformed MIDI track."

#: escalas/midi_import.py
msgid "Evento MIDI sin estado."
msgstr "MIDI event without a status."

#: escalas/midi_import.py
msgid "El MIDI no tiene notas en las pistas elegidas."
msgstr "The MIDI file has no notes in the chosen tracks."

#: escalas/models.py
msgid "Básico"
msgstr "Basic"

#: escalas/models.py
