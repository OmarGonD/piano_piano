msgstr "Christian"

#: escalas/models.py
msgid "Popular"
msgstr "Popular"

#: escalas/musicxml_import.py
msgid "No se pudo abrir el archivo .mxl."
msgstr "The .mxl file could not be opened."

#: escalas/musicxml_import.py
msgid "El archivo MusicXML está mal formado."
msgstr "The MusicXML file is malformed."

#: escalas/musicxml_import.py
msgid "Solo se admite MusicXML «partwise» (el que exportan MuseScore, Finale y Sibelius)."
msgstr "Only “partwise” MusicXML is supported (the kind exported by MuseScore, Finale and Sibelius)."

#: escalas/musicxml_import.py
msgid "El MusicXML no tiene partes."
msgstr "The MusicXML has no parts."

#: escalas/musicxml_import.py
msgid "El MusicXML no tiene notas."
msgstr "The MusicXML has no notes."

#: escalas/song_import.py
#, python-format
msgid "%(song)s · %(level)s: %(rh)d notas en la derecha, %(lh)d en la izquierda, %(tempo)d BPM, armadura %(key)d."
msgstr "%(song)s · %(level)s: %(rh)d notes in the right hand, %(lh)d in the left, %(tempo)d BPM, key signature %(key)d."

#: escalas/song_import.py
#, python-format
msgid "Nivel %(level)d: %(errors)s"
msgstr "Level %(level)d: %(errors)s"

#: escalas/templates/escalas/_input_select.html
