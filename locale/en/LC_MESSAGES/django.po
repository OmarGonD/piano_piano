msgstr "Turn on microphone"

#: escalas/templates/escalas/index.html
#: escalas/templates/escalas/modules/_exercise.html
#: escalas/templates/escalas/song.html
msgid "Nivel del micrófono (la raya es el umbral)"
msgstr "Microphone level (the line marks the threshold)"

#: escalas/templates/escalas/index.html
msgid "Pantalla completa"
msgstr "Full screen"

#: escalas/templates/escalas/index.html
msgid "Ajustes"
