#: cuentas/templates/cuentas/preferences.html
msgid "Preferencias · Piano"
msgstr "Preferences · Piano"

#: cuentas/templates/cuentas/preferences.html
msgid "Preferencias"
msgstr "Preferences"

#: cuentas/templates/cuentas/preferences.html
msgid "Las notas en el pentagrama, como en una partitura."
msgstr "The notes on the staff, like in sheet music."

#: cuentas/templates/cuentas/preferences.html
msgid "Las notas caen hacia su tecla del teclado, con un color para cada mano."
msgstr "The notes fall towards their key on the keyboard, with one colour for each hand."

#: cuentas/templates/cuentas/preferences.html
msgid "Guardar"
msgstr "Save"

#: cuentas/templates/cuentas/register.html
msgid "Registro · Piano"
msgstr "Sign up · Piano"

#: cuentas/templates/cuentas/register.html
#, python-format
msgid "¡Cuenta creada, %(name)s!"
msgstr "Account created, %(name)s!"

#: cuentas/templates/cuentas/register.html
#, python-format
msgid "Tu cuenta <b>%(user)s</b> está pendiente de activación. Para activarla, envía un correo a:"
msgstr "Your account <b>%(user)s</b> is pending activation. To activate it, send an email to:"

#: cuentas/templates/cuentas/register.html
msgid "con tu nombre de usuario. Puedes usar este botón, que deja el mensaje escrito:"
msgstr "with your username. You can use this button, which fills in the message for you:"

#: cuentas/templates/cuentas/register.html
msgid "Escribir el correo"
msgstr "Write the email"

#: cuentas/templates/cuentas/register.html
#, python-format
msgid "Cuando tu cuenta esté activa podrás <a href=\"%(login_url)s\">entrar</a>."
msgstr "Once your account is active you will be able to <a href=\"%(login_url)s\">sign in</a>."

#: cuentas/templates/cuentas/register.html
msgid "Crear cuenta"
msgstr "Create account"

#: cuentas/templates/cuentas/register.html
#, python-format
msgid "Después de registrarte, envía un correo a <b>%(admin_email)s</b> para que activen tu cuenta."
msgstr "After signing up, send an email to <b>%(admin_email)s</b> so your account gets activated."

#: cuentas/templates/cuentas/register.html
msgid "Registrarme"
msgstr "Sign me up"

#: cuentas/templates/cuentas/register.html
msgid "¿Ya tienes cuenta?"
msgstr "Already have an account?"

#: cuentas/templates/cuentas/register.html
#: cuentas/templates/registration/login.html
#: escalas/templates/escalas/_nav.html
msgid "Entrar"
msgstr "Sign in"

#: cuentas/templates/registration/login.html
msgid "Entrar · Piano"
msgstr "Sign in · Piano"

#: cuentas/templates/registration/login.html
msgid "Tu avance se guarda en tu cuenta: escalas, módulos y canciones."
msgstr "Your progress is saved in your account: scales, modules and songs."

#: cuentas/templates/registration/login.html
msgid "¿No tienes cuenta?"
msgstr "Don't have an account?"

#: cuentas/templates/registration/login.html
msgid "Regístrate"
msgstr "Sign up"

