#: cuentas/forms.py
msgid "Nombre"
msgstr "Nome"

#: cuentas/forms.py
msgid "Correo electrónico"
msgstr "E-mail"

#: cuentas/forms.py
msgid "Ya hay una cuenta con este correo."
msgstr "Já existe uma conta com este e-mail."

#: cuentas/forms.py
msgid "Tu cuenta aún no está activada. Cuando la activen podrás entrar."
msgstr "A sua conta ainda não está ativada. Quando for ativada, poderá entrar."

#: cuentas/models.py escalas/templates/escalas/song.html
msgid "Partitura"
msgstr "Partitura"

#: cuentas/models.py escalas/templates/escalas/song.html
msgid "Lluvia de notas"
msgstr "Chuva de notas"

#: cuentas/models.py
msgid "vista de las canciones"
msgstr "visualização das músicas"

#: cuentas/models.py
msgid "Partitura: las notas en el pentagrama. Lluvia de notas: las notas caen hacia su tecla."
msgstr "Partitura: as notas na pauta. Chuva de notas: as notas caem em direção à sua tecla."

#: cuentas/templates/cuentas/preferences.html
msgid "Preferencias · Piano"
msgstr "Preferências · Piano"

#: cuentas/templates/cuentas/preferences.html
msgid "Preferencias"
msgstr "Preferências"

#: cuentas/templates/cuentas/preferences.html
msgid "Las notas en el pentagrama, como en una partitura."
msgstr "As notas na pauta, como numa partitura."

#: cuentas/templates/cuentas/preferences.html
msgid "Las notas caen hacia su tecla del teclado, con un color para cada mano."
msgstr "As notas caem em direção à sua tecla do teclado, com uma cor para cada mão."

#: cuentas/templates/cuentas/preferences.html
msgid "Guardar"
msgstr "Guardar"

#: cuentas/templates/cuentas/register.html
msgid "Registro · Piano"
msgstr "Registo · Piano"

#: cuentas/templates/cuentas/register.html
#, python-format
msgid "¡Cuenta creada, %(name)s!"
msgstr "Conta criada, %(name)s!"

#: cuentas/templates/cuentas/register.html
#, python-format
msgid "Tu cuenta <b>%(user)s</b> está pendiente de activación. Para activarla, envía un correo a:"
msgstr "A sua conta <b>%(user)s</b> está pendente de ativação. Para a ativar, envie um e-mail para:"

#: cuentas/templates/cuentas/register.html
msgid "con tu nombre de usuario. Puedes usar este botón, que deja el mensaje escrito:"
msgstr "com o seu nome de utilizador. Pode usar este botão, que já deixa a mensagem escrita:"

#: cuentas/templates/cuentas/register.html
msgid "Escribir el correo"
msgstr "Escrever o e-mail"

#: cuentas/templates/cuentas/register.html
#, python-format
msgid "Cuando tu cuenta esté activa podrás <a href=\"%(login_url)s\">entrar</a>."
msgstr "Quando a sua conta estiver ativa poderá <a href=\"%(login_url)s\">entrar</a>."

#: cuentas/templates/cuentas/register.html
msgid "Crear cuenta"
msgstr "Criar conta"

#: cuentas/templates/cuentas/register.html
#, python-format
msgid "Después de registrarte, envía un correo a <b>%(admin_email)s</b> para que activen tu cuenta."
msgstr "Depois de se registar, envie um e-mail para <b>%(admin_email)s</b> para que ativem a sua conta."

#: cuentas/templates/cuentas/register.html
msgid "Registrarme"
msgstr "Registar-me"

#: cuentas/templates/cuentas/register.html
msgid "¿Ya tienes cuenta?"
msgstr "Já tem conta?"

#: cuentas/templates/cuentas/register.html
#: cuentas/templates/registration/login.html
#: escalas/templates/escalas/_nav.html
msgid "Entrar"
msgstr "Entrar"

#: cuentas/templates/registration/login.html
msgid "Entrar · Piano"
msgstr "Entrar · Piano"

#: cuentas/templates/registration/login.html
msgid "Tu avance se guarda en tu cuenta: escalas, módulos y canciones."
msgstr "O seu progresso fica guardado na sua conta: escalas, módulos e músicas."

#: cuentas/templates/registration/login.html
msgid "¿No tienes cuenta?"
msgstr "Ainda não tem conta?"

#: cuentas/templates/registration/login.html
msgid "Regístrate"
msgstr "Registe-se"

#: cuentas/views.py
#, python-format
msgid "Activar cuenta: %(user)s"
msgstr "Ativar conta: %(user)s"

#: cuentas/views.py
#, python-format
msgid ""
"Hola, me registré en la app de piano y quisiera activar mi cuenta.\n"
"\n"
"Usuario: %(user)s\n"
"Nombre: %(name)s\n"
"Correo: %(email)s\n"
msgstr ""
"Olá, registei-me na app de piano e gostaria de ativar a minha conta.\n"
"\n"
"Utilizador: %(user)s\n"
"Nome: %(name)s\n"
"E-mail: %(email)s\n"

#: cuentas/views.py
msgid "Preferencias guardadas."
msgstr "Preferências guardadas."

#: escalas/catalog_strings.py
msgid "Acompaña canciones con acordes."
msgstr "Acompanhe músicas com acordes."

#: escalas/catalog_strings.py
msgid "Acordes con sostenidos y bemoles"
msgstr "Acordes com sustenidos e bemóis"

#: escalas/catalog_strings.py
msgid "Acordes de séptima"
msgstr "Acordes de sétima"

#: escalas/catalog_strings.py
msgid "Acordes de tensión y color para dar variedad a un acompañamiento."
msgstr "Acordes de tensão e cor para dar variedade a um acompanhamento."

#: escalas/catalog_strings.py
msgid "Acordes mayores"
msgstr "Acordes maiores"

#: escalas/catalog_strings.py
msgid "Acordes menores"
msgstr "Acordes menores"

#: escalas/catalog_strings.py
msgid "Aprende a leer el pentagrama nota a nota, hasta tocar piezas escritas."
msgstr "Aprenda a ler a pauta nota a nota, até tocar peças escritas."

#: escalas/catalog_strings.py
msgid "Aprende acordes, inversiones y progresiones para tocar con otros músicos."
msgstr "Aprenda acordes, inversões e progressões para tocar com outros músicos."

#: escalas/catalog_strings.py
msgid "Arpegios de dos octavas en corcheas y bajo en negras, con el final en acordes."
msgstr "Arpejos de duas oitavas em colcheias e baixo em semínimas, com o final em acordes."

#: escalas/catalog_strings.py
msgid "Banda"
msgstr "Banda"

#: escalas/catalog_strings.py
msgid "Blues de 12 compases"
msgstr "Blues de 12 compassos"

#: escalas/catalog_strings.py
msgid "Cada nota aparece en su clave, sol o fa, como en una partitura de piano. Cambia de lectura sin pausa."
msgstr "Cada nota aparece na sua clave, sol ou fá, como numa partitura de piano. Mude de leitura sem pausa."

#: escalas/catalog_strings.py
msgid "Canción de 1968 con derechos de autor vigentes: importa tu partitura en MIDI y la app crea las tres versiones."
msgstr "Canção de 1968 com direitos de autor em vigor: importe a sua partitura em MIDI e a app cria as três versões."

#: escalas/catalog_strings.py
msgid "Clave de fa: las notas del pentagrama"
msgstr "Clave de fá: as notas da pauta"

#: escalas/catalog_strings.py
msgid "Clave de fa: líneas adicionales"
msgstr "Clave de fá: linhas suplementares"

#: escalas/catalog_strings.py
msgid "Clave de sol: las notas del pentagrama"
msgstr "Clave de sol: as notas da pauta"

#: escalas/catalog_strings.py
msgid "Clave de sol: líneas adicionales"
msgstr "Clave de sol: linhas suplementares"

#: escalas/catalog_strings.py
msgid "Con segunda voz y bajo arpegiado"
msgstr "Com segunda voz e baixo arpejado"

#: escalas/catalog_strings.py
msgid "Del Do2 grave hasta el Mi4, que se escribe sobre el pentagrama de fa."
msgstr "Do Dó2 grave até ao Mi4, que se escreve acima da pauta de fá."

#: escalas/catalog_strings.py
msgid "Disminuidos, aumentados y suspendidos"
msgstr "Diminutos, aumentados e suspensos"

#: escalas/catalog_strings.py
msgid "Do, Fa, Sol, Re, La y Mi: los acordes más usados en canciones. Verás sus notas en el teclado."
msgstr "Dó, Fá, Sol, Ré, Lá e Mi: os acordes mais usados em músicas. Verá as suas notas no teclado."

#: escalas/catalog_strings.py
msgid "Doxología"
msgstr "Doxologia"

#: escalas/catalog_strings.py
msgid "Dórica"
msgstr "Dórica"

#: escalas/catalog_strings.py
msgid "El famoso bajo en ciclo de quintas de la Suite en sol menor HWV 432. Aprende primero la mano derecha, luego la izquierda y al final las dos juntas."
msgstr "O famoso baixo em ciclo de quintas da Suíte em sol menor HWV 432. Aprenda primeiro a mão direita, depois a esquerda e, por fim, as duas juntas."

#: escalas/catalog_strings.py
msgid "El himno más cantado del mundo (Amazing Grace), en compás de tres."
msgstr "O hino mais cantado do mundo (Amazing Grace), em compasso de três tempos."

#: escalas/catalog_strings.py
msgid "El sonido más oscuro: La menor, Re menor, Mi menor y compañía."
msgstr "O som mais escuro: Lá menor, Ré menor, Mi menor e companhia."

#: escalas/catalog_strings.py
msgid "El villancico de Navidad por excelencia, con su suave balanceo en tres."
msgstr "O cântico de Natal por excelência, com o seu suave balanço em três tempos."

#: escalas/catalog_strings.py
msgid "Encadena los tres acordes principales de una tonalidad, en Do y en Sol."
msgstr "Encadeie os três acordes principais de uma tonalidade, em Dó e em Sol."

#: escalas/catalog_strings.py
msgid "Frases de ocho notas con saltos amplios y alteraciones en clave de sol."
msgstr "Frases de oito notas com saltos largos e alterações em clave de sol."

#: escalas/catalog_strings.py
msgid "Frases de ocho notas para la mano izquierda, con saltos y alteraciones."
msgstr "Frases de oito notas para a mão esquerda, com saltos e alterações."

#: escalas/catalog_strings.py
msgid "Frases por grados conjuntos"
msgstr "Frases por graus conjuntos"

#: escalas/catalog_strings.py
msgid "Frigia"
msgstr "Frígia"

#: escalas/catalog_strings.py
msgid "Generada automáticamente: la melodía y un bajo por medio compás."
msgstr "Gerada automaticamente: a melodia e um baixo a cada meio compasso."

#: escalas/catalog_strings.py
msgid "Generada automáticamente: teclas blancas, notas largas y una nota a la vez por mano."
msgstr "Gerada automaticamente: teclas brancas, notas longas e uma nota de cada vez por mão."

#: escalas/catalog_strings.py
msgid "Himno de la alegría"
msgstr "Hino à Alegria"

#: escalas/catalog_strings.py
msgid "Interestelar"
msgstr "Interestelar"

#: escalas/catalog_strings.py
msgid "La cadencia básica del jazz, con acordes de séptima, en Do, Fa, Si♭ y Mi♭."
msgstr "A cadência básica do jazz, com acordes de sétima, em Dó, Fá, Si♭ e Mi♭."

#: escalas/catalog_strings.py
msgid "La clave de la mano izquierda: de Sol2 a La3, en líneas y espacios."
msgstr "A clave da mão esquerda: do Sol2 ao Lá3, em linhas e espaços."

#: escalas/catalog_strings.py
msgid "La forma completa del blues con acordes de séptima, en Do y en Sol."
msgstr "A forma completa do blues com acordes de sétima, em Dó e em Sol."

#: escalas/catalog_strings.py
msgid "La melodía completa con la fundamental de cada acorde en la izquierda."
msgstr "A melodia completa com a fundamental de cada acorde na esquerda."

#: escalas/catalog_strings.py
msgid "La melodía de la Novena sinfonía, cantada en iglesias como «Jubilosos te adoramos»."
msgstr "A melodia da Nona Sinfonia, cantada nas igrejas como «Jubilosos te adoramos»."

#: escalas/catalog_strings.py
msgid "La progresión de cientos de canciones, en cuatro tonalidades."
msgstr "A progressão de centenas de músicas, em quatro tonalidades."

#: escalas/catalog_strings.py
msgid "La progresión pop: I–V–vi–IV"
msgstr "A progressão pop: I–V–vi–IV"

#: escalas/catalog_strings.py
msgid "Las dos claves alternadas"
msgstr "As duas claves alternadas"

#: escalas/catalog_strings.py
msgid "Las mismas notas de la clave de sol, ahora con ♯ y ♭. Fíjate en la alteración antes de tocar."
msgstr "As mesmas notas da clave de sol, agora com ♯ e ♭. Repare na alteração antes de tocar."

#: escalas/catalog_strings.py
msgid "Lee frases cortas de cinco notas que se mueven por notas vecinas, como en una melodía."
msgstr "Leia frases curtas de cinco notas que se movem por notas vizinhas, como numa melodia."

#: escalas/catalog_strings.py
msgid "Lee partituras y toca música clásica."
msgstr "Leia partituras e toque música clássica."

#: escalas/catalog_strings.py
msgid "Lidia"
msgstr "Lídia"

#: escalas/catalog_strings.py
msgid "Locria"
msgstr "Lócria"

#: escalas/catalog_strings.py escalas/templates/escalas/index.html
msgid "Mayor"
msgstr "Maior"

#: escalas/catalog_strings.py
msgid "Melodía en Do"
msgstr "Melodia em Dó"

#: escalas/catalog_strings.py
msgid "Menor armónica"
msgstr "Menor harmónica"

#: escalas/catalog_strings.py
msgid "Menor melódica"
msgstr "Menor melódica"

#: escalas/catalog_strings.py
msgid "Menor natural"
msgstr "Menor natural"

#: escalas/catalog_strings.py
msgid "Mixolidia"
msgstr "Mixolídia"

#: escalas/catalog_strings.py
msgid "Noche de paz"
msgstr "Noite Feliz"

#: escalas/catalog_strings.py
msgid "Pentatónica mayor"
msgstr "Pentatónica maior"

#: escalas/catalog_strings.py
msgid "Pentatónica menor"
msgstr "Pentatónica menor"

#: escalas/catalog_strings.py
msgid "Primera vista en clave de fa"
msgstr "Leitura à primeira vista em clave de fá"

#: escalas/catalog_strings.py
msgid "Primera vista: saltos y alteraciones"
msgstr "Leitura à primeira vista: saltos e alterações"

#: escalas/catalog_strings.py
msgid "Reconoce las nueve notas que caen en las líneas y espacios, de Mi4 a Fa5, y tócalas en el piano."
msgstr "Reconheça as nove notas que caem nas linhas e espaços, do Mi4 ao Fá5, e toque-as no piano."

#: escalas/catalog_strings.py
msgid "Segunda voz en los tiempos fuertes y bajo arpegiado en negras."
msgstr "Segunda voz nos tempos fortes e baixo arpejado em semínimas."

#: escalas/catalog_strings.py
msgid "Si♭, Mi♭, La♭, Fa♯ menor… Ahora las notas solo aparecen si te equivocas."
msgstr "Si♭, Mi♭, Lá♭, Fá♯ menor… Agora as notas só aparecem se se enganar."

#: escalas/catalog_strings.py
msgid "Solista"
msgstr "Solista"

#: escalas/catalog_strings.py
msgid "Solo teclas blancas: la melodía en notas largas y una nota de bajo por compás."
msgstr "Só teclas brancas: a melodia em notas longas e uma nota de baixo por compasso."

#: escalas/catalog_strings.py
msgid "Sostenidos y bemoles"
msgstr "Sustenidos e bemóis"

#: escalas/catalog_strings.py
msgid "Sublime gracia"
msgstr "Graça Maravilhosa"

#: escalas/catalog_strings.py
msgid "Suma el Do central y las notas que se salen del pentagrama por arriba, hasta La5."
msgstr "Some o Dó central e as notas que saem da pauta por cima, até ao Lá5."

#: escalas/catalog_strings.py
msgid "Séptima de dominante, menor séptima y séptima mayor: el color del pop, el soul y el jazz."
msgstr "Sétima dominante, sétima menor e sétima maior: a cor do pop, do soul e do jazz."

#: escalas/catalog_strings.py
msgid "Tu primera progresión: I–IV–V"
msgstr "A sua primeira progressão: I–IV–V"

#: escalas/catalog_strings.py
msgid "baja natural"
msgstr "descendente natural"

#: escalas/catalog_strings.py
msgid "ii–V–I en cuatro tonalidades"
msgstr "ii–V–I em quatro tonalidades"

#: escalas/catalog_strings.py
msgid "«A Dios el Padre celestial»: el antiguo salmo 100, en notas largas y solemnes."
msgstr "«Louvai a Deus, o Pai celestial»: o antigo salmo 100, em notas longas e solenes."

#: escalas/catalog_strings.py
msgid "Jean Renard y Pierre Delanoë (canta Sylvie Vartan)"
msgstr "Jean Renard e Pierre Delanoë (cantada por Sylvie Vartan)"

#: escalas/catalog_strings.py
msgid "Melodía tradicional «New Britain» (1829)"
msgstr "Melodia tradicional «New Britain» (1829)"

#: escalas/catalog_strings.py
msgid "Primeros pasos"
msgstr "Primeiros passos"

#: escalas/catalog_strings.py
msgid "Empieza aquí si nunca has tocado el piano."
msgstr "Comece aqui se nunca tocou piano."

#: escalas/catalog_strings.py
msgid "Conoce el teclado, encuentra las notas y toca tus primeras melodías. Después podrás seguir con Solista (leer partituras) o con Banda (acordes)."
msgstr "Conheça o teclado, encontre as notas e toque as suas primeiras melodias. Depois poderá seguir com Solista (ler partituras) ou com Banda (acordes)."

#: escalas/catalog_strings.py
msgid "Encuentra el Do"
msgstr "Encontre o Dó"

#: escalas/catalog_strings.py
msgid "El Do es la tecla blanca justo a la izquierda de cada grupo de dos teclas negras. Búscalo en todo el teclado."
msgstr "O Dó é a tecla branca logo à esquerda de cada grupo de duas teclas pretas. Procure-o em todo o teclado."

#: escalas/catalog_strings.py
msgid "Las siete notas blancas"
msgstr "As sete notas brancas"

#: escalas/catalog_strings.py
msgid "Do, Re, Mi, Fa, Sol, La y Si: aprende dónde está cada una a partir del Do central."
msgstr "Dó, Ré, Mi, Fá, Sol, Lá e Si: aprenda onde está cada uma a partir do Dó central."

#: escalas/catalog_strings.py
msgid "Cinco notas, cinco dedos"
msgstr "Cinco notas, cinco dedos"

#: escalas/catalog_strings.py
msgid "Mano derecha sobre Do, Re, Mi, Fa y Sol con los dedos 1 al 5. Toca la nota que se indica con su dedo."
msgstr "Mão direita sobre Dó, Ré, Mi, Fá e Sol com os dedos 1 a 5. Toque a nota indicada com o seu dedo."

#: escalas/catalog_strings.py
msgid "Teclas blancas sin ayuda"
msgstr "Teclas brancas sem ajuda"

#: escalas/catalog_strings.py
msgid "Ahora la tecla solo se ilumina si te equivocas. Prueba en dos octavas."
msgstr "Agora a tecla só se ilumina se se enganar. Experimente em duas oitavas."

#: escalas/catalog_strings.py
msgid "Las teclas negras"
msgstr "As teclas pretas"

#: escalas/catalog_strings.py
msgid "Sostenidos (♯) y bemoles (♭): cada tecla negra tiene dos nombres. Búscalas por su vecina blanca."
msgstr "Sustenidos (♯) e bemóis (♭): cada tecla preta tem dois nomes. Procure-as pela vizinha branca."

#: escalas/catalog_strings.py
msgid "Tu primera lectura: de Do a Sol"
msgstr "A sua primeira leitura: de Dó a Sol"

#: escalas/catalog_strings.py
msgid "Cinco notas en clave de sol, del Do central al Sol, para empezar a leer el pentagrama."
msgstr "Cinco notas em clave de sol, do Dó central ao Sol, para começar a ler a pauta."

#: escalas/catalog_strings.py
msgid "Tu primera melodía"
msgstr "A sua primeira melodia"

#: escalas/catalog_strings.py
msgid "Frases cortas de cuatro notas que suben y bajan de a poco."
msgstr "Frases curtas de quatro notas que sobem e descem aos poucos."

#: escalas/catalog_strings.py
msgid "Tus primeros acordes: Do y Sol"
msgstr "Os seus primeiros acordes: Dó e Sol"

#: escalas/catalog_strings.py
msgid "Toca tres notas a la vez: Do mayor y Sol mayor, con las teclas marcadas."
msgstr "Toque três notas ao mesmo tempo: Dó maior e Sol maior, com as teclas marcadas."

#: escalas/forms.py
msgid "La precisión no puede superar 100."
msgstr "A precisão não pode ultrapassar 100."

#: escalas/forms.py
msgid "Nombre de la canción"
msgstr "Nome da música"

#: escalas/forms.py
msgid "Autor"
msgstr "Autor"

#: escalas/forms.py
msgid "Categoría"
msgstr "Categoria"

#: escalas/forms.py
msgid "Partitura (MIDI o MusicXML)"
msgstr "Partitura (MIDI ou MusicXML)"

#: escalas/forms.py
msgid "Pista mano derecha"
msgstr "Pista da mão direita"

#: escalas/forms.py
msgid "Pista mano izquierda"
msgstr "Pista da mão esquerda"

#: escalas/forms.py
msgid "El nombre necesita al menos una letra o un número."
msgstr "O nome precisa de pelo menos uma letra ou um número."

#: escalas/forms.py
msgid "El archivo no puede pasar de 2 MB."
msgstr "O ficheiro não pode ter mais de 2 MB."

#: escalas/midi_import.py
msgid "No es un archivo MIDI (falta la cabecera MThd)."
msgstr "Não é um ficheiro MIDI (falta o cabeçalho MThd)."

#: escalas/midi_import.py
msgid "Los MIDI con división SMPTE no están soportados."
msgstr "Os ficheiros MIDI com divisão SMPTE não são suportados."

#: escalas/midi_import.py
msgid "Pista MIDI mal formada."
msgstr "Pista MIDI mal formada."

#: escalas/midi_import.py
msgid "Evento MIDI sin estado."
msgstr "Evento MIDI sem estado."

#: escalas/midi_import.py
msgid "El MIDI no tiene notas en las pistas elegidas."
msgstr "O MIDI não tem notas nas pistas escolhidas."

#: escalas/models.py
msgid "Básico"
msgstr "Básico"

#: escalas/models.py
msgid "Intermedio"
msgstr "Intermédio"

#: escalas/models.py
msgid "Avanzado"
msgstr "Avançado"

#: escalas/models.py
msgid "Clásica"
msgstr "Clássica"

#: escalas/models.py
msgid "Cristiana"
msgstr "Cristã"

#: escalas/models.py
msgid "Popular"
msgstr "Popular"

#: escalas/musicxml_import.py
msgid "No se pudo abrir el archivo .mxl."
msgstr "Não foi possível abrir o ficheiro .mxl."

#: escalas/musicxml_import.py
msgid "El archivo MusicXML está mal formado."
msgstr "O ficheiro MusicXML está mal formado."

#: escalas/musicxml_import.py
msgid "Solo se admite MusicXML «partwise» (el que exportan MuseScore, Finale y Sibelius)."
msgstr "Só é aceite MusicXML «partwise» (o que exportam o MuseScore, o Finale e o Sibelius)."

#: escalas/musicxml_import.py
msgid "El MusicXML no tiene partes."
msgstr "O MusicXML não tem partes."

#: escalas/musicxml_import.py
msgid "El MusicXML no tiene notas."
msgstr "O MusicXML não tem notas."

#: escalas/song_import.py
#, python-format
msgid "%(song)s · %(level)s: %(rh)d notas en la derecha, %(lh)d en la izquierda, %(tempo)d BPM, armadura %(key)d."
msgstr "%(song)s · %(level)s: %(rh)d notas na direita, %(lh)d na esquerda, %(tempo)d BPM, armadura %(key)d."

#: escalas/song_import.py
#, python-format
msgid "Nivel %(level)d: %(errors)s"
msgstr "Nível %(level)d: %(errors)s"

#: escalas/templates/escalas/_input_select.html
msgid "Entrada"
msgstr "Entrada"

#: escalas/templates/escalas/_input_select.html
#: escalas/templates/escalas/index.html
msgid "Entrada de notas"
